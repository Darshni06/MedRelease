# ---------------------------------------------------------------------------
# MedRelease backend configuration
# Copy this file to ".env" for local development. On Render, set these as
# Environment Variables on the Web Service instead of using a .env file.
# ---------------------------------------------------------------------------

APP_NAME=MedRelease

# Local dev: file-based SQLite, no server required.
# Production (Render): a PostgreSQL connection string, e.g.
#   postgresql://user:password@host:5432/medrelease
DATABASE_URL=sqlite:///./medrelease.db

# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub integration: "demo" uses seeded, clearly-labeled sample data with no
# network calls. "real" calls the live GitHub API using GITHUB_TOKEN below.
GITHUB_MODE=demo
GITHUB_TOKEN=
GITHUB_REPO_OWNER=medrelease-demo
GITHUB_REPO_NAME=hospital-management-system

# When true, the app seeds sample organizations/projects/users on first boot
# if the database is empty. Safe to leave on; it no-ops once data exists.
AUTO_SEED=true
